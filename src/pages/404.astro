---
/**
 * Not-found page — and the fallback half of the per-node wildcard route.
 *
 * ⛔ A STATIC BUILD CANNOT KNOW THE REQUESTED PATH. This file is rendered ONCE,
 * at build time, with `Astro.url.pathname` fixed at "/404" — the path the
 * visitor actually typed is simply not available to it. An earlier version of
 * this page tested that build-time pathname against the node-slug shape; "404"
 * matches that shape, so EVERY not-found page shipped as a node page headed
 * "404". Do not reintroduce that: there is no server-side answer here.
 *
 * So the split is done in the browser instead, and the page is correct either
 * way round:
 *
 *   - WITHOUT JavaScript, the visitor gets the plain not-found message, which
 *     also points at what a node name is. Always true, never misleading.
 *   - WITH JavaScript, a path shaped like a node slug (<=9 chars, A-Z a-z 0-9 -,
 *     per PM-166) swaps in the node explainer headed by the slug they typed —
 *     which is the case worth serving, because node names are mutable and a
 *     renamed or not-yet-listed slug lands here.
 *
 * Known slugs never reach this page at all: src/pages/[slug].astro generates a
 * real 200 page for each one.
 */
import Base from "../layouts/Base.astro";
import NodeBody from "../components/NodeBody.astro";
---

<Base title="Page not found" description="That page isn't here." noindex={true}>
  <div id="nf-generic">
    <section
      class="section section-dark"
      style="min-height:50vh;display:grid;place-items:center;text-align:center;"
    >
      <div class="wrap-narrow">
        <p class="eyebrow">Signal lost</p>
        <h1>We can't find that page.</h1>
        <p class="lede">
          The link may be old, or the page may have moved. Let's get you back on
          the mesh.
        </p>
        <p>
          If you typed a name you saw on a map pin — something like
          <strong>PalmasMesh.com/PNV1</strong> — that's the name of one of our
          radios, and we don't have a page for that one yet.
        </p>
        <div
          style="display:flex;gap:0.8rem;flex-wrap:wrap;justify-content:center;margin-top:1.5rem;"
        >
          <a href="/" class="btn btn-primary">Back home →</a>
          <a href="/faq/" class="btn btn-ghost">Read the FAQ</a>
        </div>
      </div>
    </section>
  </div>

  <div id="nf-node" hidden>
    <NodeBody slug={null} known={false} />
  </div>

  <script is:inline>
    (function () {
      var raw;
      try {
        raw = decodeURIComponent(location.pathname);
      } catch (e) {
        raw = location.pathname;
      }
      raw = raw.replace(/^\/+|\/+$/g, "");

      // PM-166: slug is <=9 bytes, ASCII, URL-safe (A-Z a-z 0-9 -).
      if (!/^[A-Za-z0-9-]{1,9}$/.test(raw)) return;

      var generic = document.getElementById("nf-generic");
      var nodeEl = document.getElementById("nf-node");
      var slugEl = document.getElementById("node-slug");
      if (!generic || !nodeEl) return;

      if (slugEl) slugEl.textContent = raw;
      generic.hidden = true;
      nodeEl.hidden = false;
      document.title = raw + " · PalmasMesh";
    })();
  </script>
</Base>
